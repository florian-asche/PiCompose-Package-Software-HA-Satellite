#!/bin/sh
set -e

case "$1" in
    configure)
        # docker-compose.yml and .env.example are managed by the package and replaced on every upgrade.
        # .env and picompose.conf belong to the user once they exist, so they are created from the shipped files only if missing.
        for project in lva snapcast local-audio bt-proxy; do
            mkdir -p "/compose/${project}"
            for file in docker-compose.yml .env.example; do
                cp -f "/usr/share/picompose/compose/${project}/${file}" "/compose/${project}/${file}"
            done
            if [ ! -e "/compose/${project}/.env" ]; then
                cp -p "/usr/share/picompose/compose/${project}/.env.example" "/compose/${project}/.env"
            fi
            if [ ! -e "/compose/${project}/picompose.conf" ]; then
                cp -p "/usr/share/picompose/compose/${project}/picompose.conf" "/compose/${project}/picompose.conf"
            fi
            # Redeploy projects that are running so they use the new files. A failure must not fail the installation.
            if command -v docker >/dev/null 2>&1; then
                running=$(docker compose --project-directory "/compose/${project}" ps --quiet 2>/dev/null || true)
                if [ -n "${running}" ]; then
                    docker compose --project-directory "/compose/${project}" down || true
                    docker compose --project-directory "/compose/${project}" up --detach || true
                fi
            fi
        done
        ;;
esac

#DEBHELPER#

exit 0
