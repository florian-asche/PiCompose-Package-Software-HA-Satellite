#!/bin/sh
set -e

case "$1" in
    configure)
        # docker-compose.yml is managed by the package and replaced on every upgrade.
        # picompose.conf and .env belong to the user once they exist, so they are copied only if missing.
        for project in lva snapcast; do
            mkdir -p "/compose/${project}"
            cp -f "/usr/share/picompose/compose/${project}/docker-compose.yml" "/compose/${project}/docker-compose.yml"
            for file in picompose.conf .env; do
                if [ ! -e "/compose/${project}/${file}" ]; then
                    cp -p "/usr/share/picompose/compose/${project}/${file}" "/compose/${project}/${file}"
                fi
            done
        done
        ;;
esac

#DEBHELPER#

exit 0
